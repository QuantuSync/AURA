{
  "name": "aura-v2",
  "version": "2.0.0-rc1",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest",
    "test:run": "vitest run",
    "test:properties": "tsx scripts/properties.ts",
    "test:properties:campaign": "cross-env FC_NUM_RUNS=200000 vitest run --reporter=verbose --testTimeout=1800000 __tests__/properties",
    "repro": "tsx scripts/reproduce.ts",
    "hindcast:capture": "tsx scripts/capture-hindcast.ts",
    "exp:smoke": "tsx scripts/experiments/smoke.ts --seed 20260804",
    "exp:coverage": "tsx scripts/experiments/coverage.ts --seed 20260804 --worlds 10000",
    "exp:h1": "tsx scripts/experiments/h1-violation.ts --seed 20260804 --worlds 2000",
    "exp:virga": "tsx scripts/experiments/virga.ts --seed 20260804 --worlds 5000",
    "exp:all": "npm run exp:coverage && npm run exp:h1 && npm run exp:virga",
    "exp:conflict-rule": "tsx scripts/experiments/conflict-rule.ts --seed 20260311 --worlds 10000 --virga-worlds 5000",
    "exp:conflict-floor": "tsx scripts/experiments/conflict-floor.ts --seed 20261007 --worlds 10000 --virga-worlds 5000 --sigma-worlds 5000",
    "exp:hindcast:e1": "tsx scripts/experiments/hindcast.ts --seed 20260804 --event e1",
    "exp:hindcast:e2": "tsx scripts/experiments/hindcast.ts --seed 20260804 --event e2",
    "exp:hindcast": "npm run exp:hindcast:e1 && npm run exp:hindcast:e2",
    "exp:hindcast:verify": "tsx scripts/experiments/hindcast.ts --seed 20260804 --event e1 --profile verify --peak-hours 24",
    "exp:coverage:c0": "tsx scripts/experiments/coverage.ts --seed 20260804 --worlds 10000 --rule C0",
    "exp:h1:c0": "tsx scripts/experiments/h1-violation.ts --seed 20260804 --worlds 2000 --rule C0",
    "exp:virga:c0": "tsx scripts/experiments/virga.ts --seed 20260804 --worlds 5000 --rule C0",
    "exp:all:c0": "npm run exp:coverage:c0 && npm run exp:h1:c0 && npm run exp:virga:c0",
    "exp:coverage:d0": "tsx scripts/experiments/coverage.ts --seed 20260804 --worlds 10000 --measure D0",
    "exp:h1:d0": "tsx scripts/experiments/h1-violation.ts --seed 20260804 --worlds 2000 --measure D0",
    "exp:virga:d0": "tsx scripts/experiments/virga.ts --seed 20260804 --worlds 5000 --measure D0",
    "exp:all:d0": "npm run exp:coverage:d0 && npm run exp:h1:d0 && npm run exp:virga:d0",
    "exp:hindcast:e1:d0": "tsx scripts/experiments/hindcast.ts --seed 20260804 --event e1 --measure D0",
    "exp:hindcast:e2:d0": "tsx scripts/experiments/hindcast.ts --seed 20260804 --event e2 --measure D0",
    "exp:hindcast:d0": "npm run exp:hindcast:e1:d0 && npm run exp:hindcast:e2:d0",
    "exp:coverage:verify": "tsx scripts/experiments/coverage.ts --seed 20260804 --worlds 200 --profile verify",
    "exp:h1:verify": "tsx scripts/experiments/h1-violation.ts --seed 20260804 --worlds 200 --profile verify",
    "exp:virga:verify": "tsx scripts/experiments/virga.ts --seed 20260804 --worlds 200 --profile verify",
    "exp:verify": "npm run exp:coverage:verify && npm run exp:h1:verify && npm run exp:virga:verify",
    "snapshots:check": "tsx scripts/verify-snapshots.ts",
    "snapshots:update": "tsx scripts/verify-snapshots.ts --update",
    "verify": "tsx scripts/verify.ts"
  },
  "dependencies": {
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "cross-env": "^10.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "fast-check": "^4.9.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5",
    "vitest": "^4.1.0"
  }
}
